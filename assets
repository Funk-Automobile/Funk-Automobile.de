:root {
    --primary: #005792;
    --secondary: #e8491d;
    --dark: #003d66;
    --light: #f4f4f4;
}

body {
    font-family: 'Arial', sans-serif;
    line-height: 1.6;
    margin: 0;
    color: #333;
}

header {
    background: var(--primary);
    color: white;
    padding: 1rem 0;
}

.logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
}

.logo {
    height: 80px;
    width: auto;
}

.hero {
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), 
                url('../images/hero.jpg') center/cover;
    height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
}

.products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin: 3rem 0;
}

.product-card {
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s;
}

.product-card:hover {
    transform: translateY(-5px);
}

.price {
    color: var(--secondary);
    font-weight: bold;
    font-size: 1.3rem;
}

@media (max-width: 768px) {
    .logo-container {
        flex-direction: column;
    }
    .hero {
        height: 50vh;
    }
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Funk Automobile - Anhänger Spezialist</title>
    <link rel="stylesheet" href="assets/css/style.css">
    <style>
        /* Kleinanzeigen-Button Stile */
        .btn-kleinanzeigen {
            background: #f56c00;
            color: white;
            display: inline-flex;
            align-items: center;
            padding: 12px 20px;
            border-radius: 4px;
            text-decoration: none;
            font-weight: bold;
            margin-top: 15px;
            transition: all 0.3s;
        }
        .btn-kleinanzeigen:hover {
            background: #e05d00;
            transform: translateY(-2px);
        }
        .kleinanzeigen-icon {
            width: 20px;
            height: 20px;
            margin-right: 10px;
        }
    </style>
</head>
<body>
    <header>
        <div class="container logo-container">
            <img src="assets/images/logo.png" alt="Funk Automobile Logo" class="logo">
            <div class="header-text">
                <h1>Funk Automobile</h1>
                <p class="header-slogan">PKW-Anhänger · Pferdeanhänger · Fahrzeugtransporter · Kühlanhänger</p>
            </div>
        </div>
    </header>
    
    <nav>
        <div class="container">
            <ul>
                <li><a href="#home">Startseite</a></li>
                <li><a href="#products">Angebot</a></li>
                <li><a href="#partners">Partner</a></li>
                <li><a href="#contact">Kontakt</a></li>
            </ul>
        </div>
    </nav>
    
    <section class="hero" id="home">
        <div class="hero-content">
            <h2>Professionelle Anhänger-Lösungen</h2>
            <p>0,75 – 3,5 Tonnen | Individuelle Beratung | Top Preise</p>
            <a href="#products" class="btn">Angebote entdecken</a>
        </div>
    </section>
    
    <section class="container" id="products">
        <h2>Unsere Top-Angebote</h2>
        <div class="products">
            <!-- PKW-Anhänger -->
            <div class="product-card">
                <img src="assets/images/pkw-anhaenger.jpg" alt="PKW-Anhänger">
                <div class="product-info">
                    <h3>PKW-Anhänger</h3>
                    <ul class="specs">
                        <li>Traglast: 750 kg - 3.500 kg</li>
                        <li>Alu- oder Stahlausführung</li>
                        <li>Mit oder ohne Plane</li>
                    </ul>
                    <p class="price">ab 3.990 €</p>
                    <a href="https://www.kleinanzeigen.de/pro/funk-automobile--1-2-3-4?utm_source=copyToPasteboard&utm_campaign=socialbuttons&utm_medium=social&utm_content=app_ios"
                       class="btn-kleinanzeigen"
                       target="_blank"
                       rel="noopener noreferrer">
                       <svg class="kleinanzeigen-icon" viewBox="0 0 24 24" fill="white">
                           <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                       </svg>
                       Zu Kleinanzeigen
                    </a>
                </div>
            </div>
            
            <!-- Pferdeanhänger -->
            <div class="product-card">
                <img src="assets/images/pferde-transport.jpg" alt="Pferdeanhänger">
                <div class="product-info">
                    <h3>Pferdeanhänger</h3>
                    <ul class="specs">
                        <li>Für 2-3 Pferde</li>
                        <li>Belüftungssystem</li>
                        <li>Stabiler Rahmen</li>
                    </ul>
                    <p class="price">ab 14.990 €</p>
                    <a href="https://www.kleinanzeigen.de/pro/funk-automobile--1-2-3-4?utm_source=copyToPasteboard&utm_campaign=socialbuttons&utm_medium=social&utm_content=app_ios"
                       class="btn-kleinanzeigen"
                       target="_blank"
                       rel="noopener noreferrer">
                       <svg class="kleinanzeigen-icon" viewBox="0 0 24 24" fill="white">
                           <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                       </svg>
                       Zu Kleinanzeigen
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="contact-info" id="contact">
        <div class="container">
            <h2>Kontakt</h2>
            <div class="contact-grid">
                <div>
                    <h3>Öffnungszeiten</h3>
                    <p>Mo-Fr: 8:00 - 18:00 Uhr</p>
                    <p>Sa: 9:00 - 14:00 Uhr</p>
                </div>
                <div>
                    <h3>Adresse</h3>
                    <p>Fritz-Minhardt-Straße 1<br>
                    76456 Kuppenheim<br>
                    Tel: <a href="tel:017647748629">0176 47748629</a><br>
                    E-Mail: <a href="mailto:Funk-Automobile@t-online.de">Funk-Automobile@t-online.de</a></p>
                </div>
            </div>
        </div>
    </section>
    
    <footer>
        <div class="container">
            <p>&copy; <span id="year"></span> Funk Automobile</p>
        </div>
    </footer>

    <script>
        document.getElementById('year').textContent = new Date().getFullYear();
    </script>
</body>
</html>

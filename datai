
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Funk Automobile - Anhänger Spezialist</title>
    <link rel="stylesheet" href="assets/css/style.css">

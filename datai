                    <ul class="specs">
                        <li>Für 2-3 Pferde</li>
                        <li>Belüftungssystem</li>
                        <li>Aluminiumrahmen</li>
                    </ul>
                    <p class="price">ab 14.990 €</p>
                    <a href="https://www.kleinanzeigen.de/pro/funk-automobile" 
                       class="btn" 
                       target="_blank">
                       Zu Kleinanzeigen
                    </a>
                </div>
            </div>
            
            <!-- Weitere Produkte... -->
        </div>
    </section>
    
    <section class="partners" id="partners">
        <div class="container">
            <h2>Unsere Partner</h2>
            <div class="partner-logos">
                <img src="assets/images/debon-trailer.jpg" alt="Debon Trailers" class="partner-logo">
            </div>
        </div>
    </section>
    
    <section class="contact-info" id="contact">
        <div class="container">
            <h2>Kontakt</h2>
            <div class="contact-grid">
                <div>
                    <h3>Öffnungszeiten</h3>
                    <p>Mo-Fr: 8:00 - 18:00 Uhr</p>
                    <p>Sa: 9:00 - 14:00 Uhr</p>
                </div>
                <div>
                    <h3>Adresse</h3>
                    <p>Fritz-Minhardt-Straße 1<br>
                    76456 Kuppenheim<br>
                    Tel: <a href="tel:017647748629">0176 47748629</a><br>
                    E-Mail: <a href="mailto:Funk-Automobile@t-online.de">Funk-Automobile@t-online.de</a></p>
                </div>
            </div>
        </div>
    </section>
    
    <footer>
        <div class="container">
            <p>&copy; <span id="year"></span> Funk Automobile</p>
            <div class="footer-links">
                <a href="#impressum">Impressum</a>
                <a href="#">Datenschutz</a>
            </div>
        </div>
    </footer>

    <script>
        document.getElementById('year').textContent = new Date().getFullYear();
    </script>
</body>
</html>
:root {
    --primary: #005792;
    --secondary: #e8491d;
    --dark: #003d66;
    --light: #f4f4f4;
}

body {
    font-family: 'Arial', sans-serif;
    line-height: 1.6;
    margin: 0;
    color: #333;
}

header {
    background: var(--primary);
    color: white;
    padding: 1rem 0;
}

.logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
}

.logo {
    height: 80px;
    width: auto;
}

.hero {
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), 
                url('../images/hero.jpg') center/cover;
    height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
}

.btn {
    background: var(--secondary);
    color: white;
    padding: 0.8rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    display: inline-block;
    transition: background 0.3s;
}

.btn:hover {
    background: #c53a17;
}

.products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin: 3rem 0;
}

.product-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.partners {
    background: var(--light);
    padding: 3rem 0;
    text-align: center;
}

.partner-logos {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 2rem;
}

.partner-logo {
    height: 80px;
    filter: grayscale(100%);
    transition: filter 0.3s;
}

.partner-logo:hover {
    filter: grayscale(0);
}

@media (max-width: 768px) {
    .logo-container {
        flex-direction: column;
    }
    .hero {
        height: 50vh;
    }
    .partner-logos {
        flex-direction: column;
        align-items: center;
    }
}
